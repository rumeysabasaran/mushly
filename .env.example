# Copy this file to ".env" and paste your key(s) below.
# .env is NEVER committed (it is in .gitignore); this example file is.
# Without any key, the app runs in demo mode (fake results).

# --- Default: Google Gemini (free tier) ---
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Free fallback: Evren LLM API — used automatically if Gemini fails ---
# Create a key on the /api-keys page of the Evren dashboard.
EVREN_API_KEY=
# EVREN_MODEL=qwen3-vl-30b

# --- Paid fallback: Claude — only if the others fail too ---
# ANTHROPIC_API_KEY=

# Optional: the order services are tried in (default: gemini,evren,claude)
# RECOGNIZER_ORDER=evren,gemini

# --- Where the app sends its requests ---
# Empty (default): the dev server on this computer (npm start) answers them.
# Set it to use the hosted server instead, e.g. to test without the local keys:
# EXPO_PUBLIC_API_URL=https://api.mushly.workers.dev
