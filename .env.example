# Copy this file to ".env" and paste your key(s) below.
# .env is NEVER committed (it is in .gitignore); this example file is.
# Without any key, the app runs in demo mode (fake results).

# --- Default: Evren LLM API (free) ---
# Create a key on the /api-keys page of the Evren dashboard.
EVREN_API_KEY=
# Optional: another vision-capable model (e.g. qwen3-vl-30b is faster but less detailed)
# EVREN_MODEL=gemma-4-31b

# --- Free fallback: Google Gemini — used automatically if Evren fails ---
# Get a key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Paid fallback: Claude — only if the others fail too ---
# ANTHROPIC_API_KEY=

# Optional: the order services are tried in (default: evren,gemini,claude)
# RECOGNIZER_ORDER=evren,gemini
